// Cloudflare deploys the finished pages in ./site, plus worker/index.js, which only handles what isn't a
// file and, every 15 minutes, starts the data refresh when a result is due (see the comment there).
// "name" must match the Worker that rugbyanalysis.com is attached to.
{
  "name": "dry-limit-ba4f",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // The pages people arrive on run through the Worker first, so it can count a ?ref= source tag (see countVisit),
  // and so does the app's live scores (worker/live.js).
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/", "/go", "/getapp", "/clubs", "/sevens", "/app/live.json"] },
  // Visits by source: the tag and the page only. No cookies, no IP address, nothing about the visitor.
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "rugby_visits" }],
  // Cloudflare builds a preview of every pull request (Workers Builds, "wrangler preview"), which refuses to start
  // unless each binding has a preview-safe copy. Previews count visits into their own dataset, never the real one.
  "previews": { "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "rugby_visits_preview" }] },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}

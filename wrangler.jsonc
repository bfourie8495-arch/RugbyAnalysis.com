// Cloudflare deploys the finished pages in ./site, plus worker/index.js, which only handles what isn't a
// file and, every 15 minutes, starts the data refresh when a result is due (see the comment there).
// "name" must match the Worker that rugbyanalysis.com is attached to.
{
  "name": "dry-limit-ba4f",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}

// Cloudflare deploys the finished pages in ./site, plus worker/index.js, which only handles what isn't a
// file and, every 15 minutes, starts the data refresh when a result is due (see the comment there).
// "name" must match the Worker that rugbyanalysis.com is attached to.
{
  "name": "dry-limit-ba4f",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // The pages people arrive on run through the Worker first, so it can count a ?ref= source tag (see countVisit).
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/", "/go", "/getapp", "/clubs", "/sevens"] },
  // Visits by source: the tag and the page only. No cookies, no IP address, nothing about the visitor.
  "analytics_engine_datasets": [{ "binding": "VISITS", "dataset": "rugby_visits" }],
  "triggers": { "crons": ["*/15 * * * *"] },
  "observability": { "enabled": true }
}
